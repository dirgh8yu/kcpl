<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The home screen widget: the shipment worth a glance. KCPL only;
             KCPL Ops has no widget. -->
        <receiver
            android:name=".KcplShipmentWidget"
            android:exported="false"
            android:label="@string/kcpl_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kcpl_shipment_widget" />
        </receiver>
    </application>
</manifest>
