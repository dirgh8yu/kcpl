<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Flutter's template grants this only to debug builds; a release build
         without it cannot reach KCPL at all. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+: asked for only when the person turns push on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- No backup of any kind: the sign-in and the offline copies stay on
         this phone. The document scanner plugin brings backup rules and an
         application theme of its own; ours win, and its theme is dropped. -->
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:fullBackupContent="false"
        tools:replace="android:fullBackupContent"
        tools:remove="android:dataExtractionRules,android:theme"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Push notifications: the K in the status bar, in KCPL crimson. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/kcpl_crimson" />
        <!-- Fetch the text and barcode models with the app rather than on the
             first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,barcode" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- kcpl:// links bring the app forward; the app decides what to
                 show, not Flutter's router. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
