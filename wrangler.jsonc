{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapileshwor-cargo",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
