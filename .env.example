# Public canonical origin, without a trailing slash.
# For the free Cloudflare deployment, set this to the assigned workers.dev URL.
NEXT_PUBLIC_SITE_URL=

# Optional. Analytics loads only in production after the visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Required for /admin. Store these as encrypted Cloudflare Worker secrets.
KCPL_ADMIN_PASSWORD=
KCPL_ADMIN_SESSION_SECRET=

# Optional identity shown in the dashboard and attached to internal notes.
KCPL_ADMIN_NAME=KCPL Admin
KCPL_ADMIN_EMAIL=
