# Public canonical origin, without a trailing slash.
# Use the permanent public domain in production; keep preview origins separate.
NEXT_PUBLIC_SITE_URL=https://kapileshworcargo.com.np

# Optional additional public origins accepted for state-changing browser requests.
# Comma-separated HTTPS origins only in production, without paths.
KCPL_ALLOWED_ORIGINS=

# Optional. Analytics loads only in production after the visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Initial KCPL staff bootstrap allowlist only.
# A configured email may establish Management access only while staff_profiles is empty.
# Once a persisted staff profile exists, its active/role/branch state is authoritative and
# this environment value never upgrades that profile.
KCPL_ADMIN_EMAILS=

# Development / Vercel Preview-only QA authentication bypass for v0/browser testing.
# When enabled, KCPL creates a synthetic Management QA identity and does not require
# Firebase Authentication or a Firestore staff profile. Production always ignores it.
# KCPL_QA_EMAIL is only the display/audit email for that synthetic QA identity.
KCPL_QA_AUTH_BYPASS=false
KCPL_QA_EMAIL=

# Legacy role-list variables are retained only for deployment compatibility. They are NOT
# staff authorization sources. Create real Firestore staff_profiles for every staff user.
KCPL_MANAGEMENT_EMAILS=
KCPL_ACCOUNTS_EMAILS=
KCPL_COMMERCIAL_EMAILS=
KCPL_OPERATIONS_EMAILS=

# Internal scheduler/automation bearer secret. This authorizes only /api/internal/automation.
# Store it in Firebase App Hosting / Secret Manager and use at least 32 random characters.
KCPL_AUTOMATION_SECRET=

# Dedicated external tracking-ingestion principal for /api/integrations/tracking.
# Do not reuse the scheduler/automation, GPT, EDI, pickup or carrier-provider secrets.
KCPL_TRACKING_INGEST_SECRET=

# Dedicated pickup-provider principal for /api/integrations/pickups.
# Do not reuse the scheduler/automation, GPT, EDI or tracking-ingestion secrets.
KCPL_PICKUP_INTEGRATION_SECRET=

# Custom GPT Actions secret for the privileged internal read-only /api/gpt gateway.
# This key represents an organization-wide KCPL Management intelligence principal, not an
# individual staff user. It must never be reused by customers, vendors, public clients or
# another KCPL subsystem. Store it server-side and use at least 32 random characters.
KCPL_GPT_ACTION_SECRET=

# Freight EDI bridge secret for /api/integrations/edi only.
# It authenticates KCPL's approved VAN/middleware bridge at organization scope; it is not
# a staff identity or per-branch credential. Canonical matched records determine branch.
# Keep it server-side in Firebase Secret Manager and use at least 32 random characters.
KCPL_EDI_SECRET=

# Carrier integration credentials. Keep every value server-side in Firebase App Hosting /
# Secret Manager. Do not expose these as NEXT_PUBLIC_* values.
# DHL Express MyDHL REST API uses pre-emptive HTTP BasicAuth.
# Safe default in code is the DHL test environment; set the base URL to production only
# after KCPL receives productive credentials and is ready to consume real shipment data.
DHL_EXPRESS_API_USER=
DHL_EXPRESS_API_PASSWORD=
DHL_EXPRESS_API_BASE_URL=https://express.api.dhl.com/mydhlapi/test
DHL_EXPRESS_ACCOUNT_NUMBER=

# Maersk Ocean schedules use a Consumer-Key. Private DCSA products use OAuth 2.0 client
# credentials after Maersk provisions the integration. The token endpoint is intentionally
# explicit because it must match the Maersk environment/product KCPL is approved for.
MAERSK_CONSUMER_KEY=
MAERSK_CLIENT_SECRET=
MAERSK_OAUTH_TOKEN_URL=
MAERSK_API_BASE_URL=https://api.maersk.com
# Configure this bearer secret on the KCPL Maersk/DCSA webhook callback when registering it.
MAERSK_WEBHOOK_SECRET=

# Google Maps Platform server-only keys used by KCPL Operations.
# Keep these in Firebase App Hosting / Secret Manager. Never expose as NEXT_PUBLIC_*.
GOOGLE_MAPS_ROUTES_API_KEY=
GOOGLE_MAPS_PLACES_API_KEY=

# SendGrid transactional quote-email integration.
# The sender address/domain must be verified in SendGrid.
SENDGRID_API_KEY=
KCPL_EMAIL_FROM=
KCPL_EMAIL_FROM_NAME=Kapileshwor Cargo Pvt. Ltd. (KCPL)
KCPL_EMAIL_REPLY_TO=

# Optional/dormant. Kept only for the previous SeaRates market-index adapter.
SEARATES_FREIGHT_INDEX_API_KEY=

# Firebase App Hosting automatically injects FIREBASE_CONFIG and the web SDK
# configuration used by the Firebase Admin and JavaScript SDKs. No Firebase
# API key, project ID, service-account JSON or storage bucket needs to be
# checked into this repository for the hosted deployment.

# Local development only, outside Google infrastructure, may use explicit
# Firebase configuration and Application Default Credentials as needed.

# Web push for the customer portal (optional).
#
# All three must be set or push is off: the control does not appear in portal
# settings and the notification sweep skips the transport entirely. Email is
# unaffected either way.
#
# The key pair is a P-256 pair, base64url encoded: the public value is the
# 65-byte uncompressed point, the private value the 32-byte scalar. Generate
# one with node:
#
#   node -e 'const c=require("crypto").createECDH("prime256v1");c.generateKeys();
#   const b=b=>b.toString("base64").replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
#   console.log("public",b(c.getPublicKey()));console.log("private",b(c.getPrivateKey()))'
#
# The subject is a contact the push service can reach if KCPL misbehaves.
KCPL_VAPID_PUBLIC_KEY=
KCPL_VAPID_PRIVATE_KEY=
KCPL_VAPID_SUBJECT=mailto:ops@kapileshworcargo.com
