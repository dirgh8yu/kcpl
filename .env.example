# Public canonical origin, without a trailing slash.
# After cutover, set this to the Firebase App Hosting *.hosted.app URL or custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional additional public origins accepted for state-changing browser requests.
# Comma-separated HTTPS origins only in production, without paths.
KCPL_ALLOWED_ORIGINS=

# Optional. Analytics loads only in production after the visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# KCPL admin bootstrap/authorization allowlist.
# Comma-separated Firebase Authentication email addresses allowed into /admin.
# Firestore staff_profiles is the normal source of role + branch truth after bootstrap.
KCPL_ADMIN_EMAILS=

# Explicit no-profile role fallbacks for bootstrap/recovery only.
# An email must appear in at most ONE role list. Duplicate role assignments fail closed.
# An allowlisted admin with no staff profile and no explicit role gets Operations
# capabilities with NO branch access. The first allowlisted admin may bootstrap
# Management only while the staff_profiles collection is completely empty.
KCPL_MANAGEMENT_EMAILS=
KCPL_ACCOUNTS_EMAILS=
KCPL_COMMERCIAL_EMAILS=
KCPL_OPERATIONS_EMAILS=

# Scheduler/automation bearer secret. Store this in Firebase App Hosting / Secret Manager.
# Use at least 32 characters of high-entropy random material.
KCPL_AUTOMATION_SECRET=

# Custom GPT Actions secret for the read-only /api/gpt gateway.
# Keep this separate from Firebase credentials and KCPL_AUTOMATION_SECRET.
# Store it in Firebase App Hosting / Secret Manager and use at least 32 characters.
KCPL_GPT_ACTION_SECRET=

# Google Maps Platform server-only keys used by KCPL Operations.
# Keep these in Firebase App Hosting / Secret Manager. Never expose as NEXT_PUBLIC_*.
GOOGLE_MAPS_ROUTES_API_KEY=
GOOGLE_MAPS_PLACES_API_KEY=

# SendGrid transactional quote-email integration.
# The sender address/domain must be verified in SendGrid.
SENDGRID_API_KEY=
KCPL_EMAIL_FROM=
KCPL_EMAIL_FROM_NAME=Kapileshwor Cargo Pvt. Ltd. (KCPL)
KCPL_EMAIL_REPLY_TO=

# Optional/dormant. Kept only for the previous SeaRates market-index adapter.
SEARATES_FREIGHT_INDEX_API_KEY=

# Firebase App Hosting automatically injects FIREBASE_CONFIG and the web SDK
# configuration used by the Firebase Admin and JavaScript SDKs. No Firebase
# API key, project ID, service-account JSON or storage bucket needs to be
# checked into this repository for the hosted deployment.

# Local development only, outside Google infrastructure, may use explicit
# Firebase configuration and Application Default Credentials as needed.
