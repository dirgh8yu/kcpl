# Public canonical origin, without a trailing slash.
# During migration this will be the Firebase App Hosting *.hosted.app URL.
NEXT_PUBLIC_SITE_URL=

# Optional. Analytics loads only in production after the visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Firebase web app config. These values are public identifiers, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase identifiers used by Firebase Admin.
# App Hosting supplies Google application credentials automatically at runtime.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Required server-side allowlist for KCPL Operations staff.
# Comma-separated Firebase Authentication email addresses.
KCPL_ADMIN_EMAILS=

# Local development only when not running on Google infrastructure:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
